App(
    appid="pokemon",
    name="Pokemon Trade Tool",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="pokemon_app",
    requires=["gui"],
    stack_size=2 * 1024,
    fap_version=[3,1],
    fap_category="GPIO",
    sources=["*.c*", "!tests", "!gba", "!cart", "!pokemon_gen3_cart*.c"],
    fap_icon="pokemon_10px.png",
    fap_icon_assets="assets",
    fap_file_assets="files",
    fap_author="Kris Bahnsen, Esteban Fuentealba, ProteanReverie, Darryn Cull",
    fap_weburl="https://github.com/kbembedded/Flipper-Zero-Game-Boy-Pokemon-Trading",
    fap_description="Pokemon exchange from Flipper Zero to Game Boy and Game Boy Advance, supports Generation I & II and Gen III Ruby/Sapphire/FireRed/LeafGreen non-Japanese games",
    fap_private_libs=[
        Lib(
            name="flipper-gblink",
            fap_include_paths=["gblink/include", "./"],
            sources=["gblink/*.c"],
        ),
    ],
)

App(
    appid="pokemon_cart",
    name="Pokemon Cartridge",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="pokemon_cart_app",
    requires=["gui"],
    stack_size=2 * 1024,
    fap_version=[3,1],
    fap_category="GPIO",
    cdefines=["POKEMON_CART_APP"],
    sources=[
        "cart/pokemon_cart_app.c",
        "src/scenes/pokemon_scene.c",
        "src/scenes/pokemon_gen3_common.c",
        "src/scenes/pokemon_gen3_edit.c",
        "src/scenes/pokemon_gen3_item.c",
        "src/scenes/pokemon_gen3_move.c",
        "src/scenes/pokemon_gen3_number.c",
        "src/scenes/pokemon_gen3_pick.c",
        "src/scenes/pokemon_gen3_pk3.c",
        "src/scenes/pokemon_gen3_pokerus.c",
        "src/scenes/pokemon_gen3_species.c",
        "src/scenes/pokemon_gen3_text.c",
        "src/scenes/pokemon_gen3_cart*.c",
        "src/views/gen3_species_select.c",
        "src/named_list.c",
        "src/stat_nl.c",
        "src/gen3/mlink_hw_furi.c",
        "src/gen3/gen3_bulk_furi.c",
        "src/gen3/gen3_pins_furi.c",
        "src/gen3/gen3_pk3_furi.c",
        "src/gen3/gen3_store_furi.c",
        "src/gen3/gen3_cart_furi.c",
        "src/gen3/gen3_data.c",
        "src/gen3/gen3_data_gen.c",
        "src/gen3/gen3_edit.c",
        "src/gen3/gen3_letters.c",
        "src/gen3/gen3_pk3.c",
        "src/gen3/gen3_pkm.c",
        "src/gen3/gen3_rules.c",
        "src/gen3/gen3_text.c",
        "src/gen3/gen3_trade_block.c",
        "src/gen3/gen3_mb.c",
        "src/gen3/gen3_hlink.c",
        "src/gen3/gen3_hcli.c",
        "src/gen3/gen3_save.c",
        "src/gen3/gen3_cart_id.c",
        "src/gen3/gen3_cart.c",
        "src/gen3/gen3_cart_screen.c",
        "src/views/gen3_cart_progress.c",
    ],
    fap_icon="pokemon_10px.png",
    fap_file_assets="files",
    fap_author="Kris Bahnsen, Esteban Fuentealba, ProteanReverie, Darryn Cull",
    fap_weburl="https://github.com/kbembedded/Flipper-Zero-Game-Boy-Pokemon-Trading",
    fap_description="Back up, browse, edit, write back and restore Gen III Game Boy Advance cartridge saves over the link cable",
    fap_private_libs=[
        Lib(
            name="flipper-gblink",
            fap_include_paths=["gblink/include", "./"],
            sources=["gblink/*.c"],
        ),
    ],
)
